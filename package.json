{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "turbo run clean",
    "clean:all": "turbo run clean:all && rm -rf .husky .turbo pnpm-lock.yaml node_modules",
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check && turbo run lint",
    "lint:fix": "biome check --write --unsafe && turbo run lint -- --fix",
    "format": "biome format --write",
    "format:check": "biome check --write",
    "types:check": "turbo run types:check",
    "version": "changeset version && pnpm install",
    "release": "bash ./scripts/publish.sh"
  },
  "keywords": [],
  "author": "Lukman Aviccena <lukman@pelatform.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@pelatform/biome-config": "^0.1.6",
    "@types/node": "^25.5.0",
    "commitlint-plugin-function-rules": "^4.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "turbo": "2.8.20",
    "typescript": "^6.0.2"
  },
  "workspaces": [
    "packages/**",
    "apps/**"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": "biome check --write --no-errors-on-unmatched",
    "*.{md,yml,yaml}": "prettier --write",
    "*.{json,jsonc,html}": "biome format --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
