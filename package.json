{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "turbo run clean",
    "clean:all": "turbo run clean:all && rm -rf .husky .turbo pnpm-lock.yaml node_modules",
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check && turbo run lint",
    "lint:fix": "biome check --write --unsafe && turbo run lint -- --fix",
    "format": "biome format --write",
    "format:check": "biome check --write",
    "types:check": "turbo run types:check",
    "version": "changeset version && pnpm install",
    "release": "bash ./scripts/publish.sh"
  },
  "keywords": [],
  "author": "Lukman Aviccena <lukman@pelatform.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@pelatform/biome-config": "^0.1.7",
    "@types/node": "^25.9.2",
    "commitlint-plugin-function-rules": "^5.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "turbo": "2.9.17",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "5.9.3"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": "biome check --write --no-errors-on-unmatched",
    "*.{md,yml,yaml}": "prettier --write",
    "*.{json,jsonc,html}": "biome format --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.5.3"
}
